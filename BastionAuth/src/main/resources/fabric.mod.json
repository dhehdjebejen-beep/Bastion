{
  "schemaVersion": 1,
  "id": "bastionauth",
  "version": "${version}",
  "name": "BastionAuth",
  "description": "Hardened self-hosted authentication for offline-mode Fabric servers: Argon2id password hashing with pepper, SQLite storage, packet-level freeze of unauthenticated players, brute-force protection and IP-bound session resume.",
  "authors": [
    "dhehdjebejen-beep"
  ],
  "contact": {
    "sources": "https://github.com/dhehdjebejen-beep/Bastion",
    "issues": "https://github.com/dhehdjebejen-beep/Bastion/issues",
    "homepage": "https://github.com/dhehdjebejen-beep/Bastion"
  },
  "license": "PolyForm-Strict-1.0.0",
  "environment": "*",
  "entrypoints": {
    "server": [
      "dev.bastionauth.BastionAuth"
    ]
  },
  "mixins": [
    "bastionauth.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
